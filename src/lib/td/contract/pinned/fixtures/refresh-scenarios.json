        },
        {
          "do": "refresh",
          "token": "s",
          "requestId": "req-rotate-000000001",
          "expect": {
            "status": 200
          }
        },
        {
          "do": "me",
          "token": "s",
          "expect": {
            "status": 200
          }
        }
      ]
    },
    {
      "name": "the same request retried within 60 s gets the same successor while it is unused",
      "steps": [
        {
          "do": "login",
          "as": "s"
        },
        {
          "do": "refresh",
          "token": "s@0",
          "requestId": "req-retry-0000000001",
          "expect": {
            "status": 200
          },
          "save": "first"
        },
        {
          "do": "refresh",
          "token": "s@0",
          "requestId": "req-retry-0000000001",
          "expect": {
            "status": 200,
            "sameAs": "first"
          }
        },
        {
          "do": "refresh",
          "token": "s",
          "requestId": "req-retry-0000000002",
          "expect": {
            "status": 200
          }
        }
      ]
    },
    {
